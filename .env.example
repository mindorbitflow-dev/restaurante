# Modo de funcionamiento
# true = Modo Demostración local (catálogo mock con persistencia en localStorage)
# false = Conectar a base de datos real de Supabase
NEXT_PUBLIC_DEMO_MODE=true

# Credenciales de Supabase (Obligatorias si NEXT_PUBLIC_DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase
